{
  "name": "pi-closeout",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Session closeout gate for coding agents: flags staged-but-uncommitted sweep fuel, untracked stash-bait, dirty child repos, and open task claims when a session ends — plus Work-Session identity rows.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "session",
    "closeout",
    "git",
    "multi-agent",
    "coding-agent",
    "hygiene"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jyyyeung/pi-closeout.git"
  },
  "pi": {
    "extensions": ["./extensions/closeout.ts"],
    "skills": ["./skills/closeout"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  }
}
